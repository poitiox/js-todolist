{
  "name": "js-todolist",
  "version": "4.0.0",
  "private": true,
  "description": "使用 React 状态驱动与 TypeScript 严格类型的待办列表",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier --write src/ index.html package.json tsconfig*.json .eslintrc.cjs eslint.config.cjs .prettierrc.json README.md",
    "format:check": "prettier --check src/ index.html package.json tsconfig*.json .eslintrc.cjs eslint.config.cjs .prettierrc.json README.md"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
